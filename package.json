{
  "name": "football-match-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:engine": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "build": "npm run build:engine && npm run build:web",
    "test": "vitest run",
    "calibrate": "npm run build:engine && node dist/calibration/run-calibration.js",
    "validate:strength": "npm run build:engine && node dist/calibration/validate-strength.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "framer-motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
