{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/engine/**/*.ts", "src/calibration/**/*.ts", "src/index.ts"],
  "exclude": ["node_modules", "dist", "src/engine/__tests__"]
}
